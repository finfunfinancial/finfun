# Edge Function secrets. Local: copy to supabase/functions/.env (git-ignored).
# Production: Supabase Dashboard → Edge Functions → Secrets, or `supabase secrets set --env-file <file>`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Long random string; signs student passwords. Generate with: openssl rand -hex 32
STUDENT_PIN_PEPPER=
# Version of the privacy policy / consent text parents agree to.
CONSENT_POLICY_VERSION=2026-10

# Razorpay (Dashboard → Settings → API Keys / Webhooks). Empty = payments switched off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Zoom Server-to-Server OAuth app (Marketplace → Develop → Build App). Empty = live classes switched off.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom Meeting SDK app (students join inside our page).
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
