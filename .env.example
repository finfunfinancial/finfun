# Public site URL (canonical URLs, sitemap, share links). Leave unset on Vercel to use the *.vercel.app address.
NEXT_PUBLIC_SITE_URL=

# Forms: every lead is POSTed as JSON here (Google Sheets Apps Script, Zoho/HubSpot webhook, Zapier…)
LEAD_WEBHOOK_URL=
# Where the impact report PDF lives (shown after the email gate)
IMPACT_REPORT_URL=

# Checkout hand-off per program (Graphy checkout or Razorpay payment page). Empty = team follows up manually.
NEXT_PUBLIC_CHECKOUT_BASIC=
NEXT_PUBLIC_CHECKOUT_PRO=
NEXT_PUBLIC_CHECKOUT_ADVANTAGE=
# Course login (Graphy)
NEXT_PUBLIC_LOGIN_URL=
NEXT_PUBLIC_FINANCIAL_PASSPORT_URL=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Accounts, My courses and the admin portal (Supabase). Unset = /login shows the old page and /admin says "being set up".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
# "on" = /enrol asks buyers to log in and pay online. Leave off until parents can receive login codes (SMS / email).
NEXT_PUBLIC_ONLINE_CHECKOUT=
